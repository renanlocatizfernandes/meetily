{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Meetily Live Plus",
    "version": "1.0.0",
    "identifier": "com.techfernandes.meetilylive",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Meetily Live Plus",
                "width": 1100,
                "height": 700,
                "preventOverflow": true,
                "resizable": true,
                "fullscreen": false,
                "decorations": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: http://asset.localhost https://asset.localhost data:",
                "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/doodle/*"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability with file system and media access",
                    "windows": [
                        "main",
                        "live-assist"
                    ],
                    "permissions": [
                        "fs:default",
                        "fs:allow-read-file",
                        "fs:read-all",
                        "fs:write-all",
                        "fs:allow-app-read",
                        "fs:allow-app-write",
                        "fs:allow-download-write",
                        "fs:allow-download-read",
                        "fs:scope-download",
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "process:default",
                        "updater:default",
                        {
                            "identifier": "fs:scope",
                            "allow": [
                                {
                                    "path": "$APPDATA/*"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "shortDescription": "Gravação, transcrição e resumo de reuniões no seu computador",
        "longDescription": "Meetily Live Plus grava reuniões, transcreve o áudio no próprio computador e gera resumos com modelos locais ou com o provedor que você escolher. Versão modificada por Renan Locatiz Fernandes (Tech Fernandes), baseada no Meetily, projeto de código aberto da Zackriya Solutions.",
        "category": "Productivity",
        "publisher": "Tech Fernandes",
        "homepage": "https://techfernandes.com.br/meetily-live-plus/",
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/icon.png",
            "icons/icon_512x512.png",
            "icons/icon_256x256.png",
            "icons/128x128.png",
            "icons/32x32.png",
            "icons/icon_16x16.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "libvulkan1",
                    "libpulse0",
                    "libasound2",
                    "libgomp1",
                    "libssl3"
                ]
            }
        },
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NjE2RkQzMDY2NkQwRDQKUldUVTBHWUcwMjlodDc0QU5Qb0F3RUJudnJTTmdubGVRQWttNHVjMUQrK0EvRVlXMXFQQTI2MVEK",
            "endpoints": [
                "https://github.com/renanlocatizfernandes/meetily/releases/latest/download/latest.json"
            ]
        }
    }
}
