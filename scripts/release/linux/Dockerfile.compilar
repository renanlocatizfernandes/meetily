# Imagem de compilação cruzada: roda em arm64 (nativo no Mac Apple Silicon) e
# gera binários x86_64-unknown-linux-gnu contra as bibliotecas amd64 do
# Ubuntu 22.04 (webkit2gtk-4.1, glibc 2.35), instaladas por multiarch.
#
# Os poucos executáveis x86_64 usados durante o build (glslc do SDK do Vulkan,
# o ffmpeg baixado pelo build.rs) rodam pela emulação binfmt/qemu do Docker.
FROM --platform=linux/arm64 ubuntu:22.04

ARG RUST_VERSION=1.99.1
ARG NODE_VERSION=22.21.1
ARG PNPM_VERSION=9.15.9
ARG VULKAN_SDK_VERSION=1.4.363.0
ARG VULKAN_SDK_SHA256=197962f5cbf80baf2775a03336a01cee7c8745686c65aaa70d3f751ade4d7e43

ENV DEBIAN_FRONTEND=noninteractive

# arm64 vem de ports.ubuntu.com; amd64 vem de archive/security.
# libssl-dev nativa: os build scripts (que rodam em arm64) usam reqwest/OpenSSL.
RUN sed -i 's/^deb /deb [arch=arm64] /' /etc/apt/sources.list \
 && for s in jammy jammy-updates; do \
      echo "deb [arch=amd64] http://archive.ubuntu.com/ubuntu $s main restricted universe multiverse"; \
    done > /etc/apt/sources.list.d/amd64.list \
 && echo "deb [arch=amd64] http://security.ubuntu.com/ubuntu jammy-security main restricted universe multiverse" >> /etc/apt/sources.list.d/amd64.list \
 && dpkg --add-architecture amd64 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential crossbuild-essential-amd64 cmake pkg-config \
      ca-certificates curl git file python3 rsync xz-utils \
      clang libclang-dev libssl-dev \
      libwebkit2gtk-4.1-dev:amd64 libappindicator3-dev:amd64 librsvg2-dev:amd64 \
      libasound2-dev:amd64 libopenblas-dev:amd64 libx11-dev:amd64 libxtst-dev:amd64 \
      libxrandr-dev:amd64 libpulse-dev:amd64 libssl-dev:amd64 libvulkan-dev:amd64 \
 && rm -rf /var/lib/apt/lists/*

# Node e pnpm (nativos arm64).
RUN curl -fsSL --retry 3 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
 && npm install -g "pnpm@${PNPM_VERSION}" \
 && node --version && pnpm --version

# Rust fixo (o projeto exige 1.99.1) com o alvo x86_64.
ENV RUSTUP_HOME=/opt/rust/rustup
RUN curl -fsSL --retry 3 https://sh.rustup.rs \
      | CARGO_HOME=/opt/rust/cargo sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
          --target x86_64-unknown-linux-gnu --no-modify-path
ENV PATH=/opt/rust/cargo/bin:$PATH

# SDK do Vulkan da LunarG (mesma versão e hash do build original): só os
# cabeçalhos e o glslc. A biblioteca de link é a libvulkan-dev:amd64 do Ubuntu.
RUN curl -fL --retry 3 "https://sdk.lunarg.com/sdk/download/${VULKAN_SDK_VERSION}/linux/vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz" -o /tmp/vulkan-sdk.tar.xz \
 && echo "${VULKAN_SDK_SHA256}  /tmp/vulkan-sdk.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/vulkan-sdk \
 && tar -xf /tmp/vulkan-sdk.tar.xz -C /opt/vulkan-sdk --strip-components=1 \
      "${VULKAN_SDK_VERSION}/x86_64/include" "${VULKAN_SDK_VERSION}/x86_64/bin/glslc" \
 && rm /tmp/vulkan-sdk.tar.xz \
 && test -f /opt/vulkan-sdk/x86_64/include/vulkan/vulkan.h \
 && /opt/vulkan-sdk/x86_64/bin/glslc --version

# O gerador de shaders do whisper.cpp dispara um glslc por shader, todos ao
# mesmo tempo. Emulados (qemu), eles esgotam a memória da VM. Este invólucro
# deixa rodar no máximo 4 por vez.
RUN mv /opt/vulkan-sdk/x86_64/bin/glslc /opt/vulkan-sdk/x86_64/bin/glslc.real \
 && printf '%s\n' '#!/bin/sh' \
      'exec flock "/tmp/glslc-vaga-$(( $$ % 4 ))" /opt/vulkan-sdk/x86_64/bin/glslc.real "$@"' \
      > /opt/vulkan-sdk/x86_64/bin/glslc \
 && chmod +x /opt/vulkan-sdk/x86_64/bin/glslc \
 && glslc_out="$(/opt/vulkan-sdk/x86_64/bin/glslc --version)" && echo "$glslc_out"

WORKDIR /work
